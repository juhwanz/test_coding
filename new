#!/usr/bin/env bash
# 문제 폴더를 만든다.  사용: ./new <boj|pg|sql> <번호> [교재위치]
# 예: ./new boj 1260   /   ./new pg 12977 stage2/A/u08
# 모의 코테: ./new boj 2615 mock/2026-12-01  (problems.txt에 없어도 만든다)
set -euo pipefail
cd "$(dirname "$0")"

if [ $# -lt 2 ]; then
  echo "사용: ./new <boj|pg|sql> <번호> [교재위치]"
  exit 1
fi
site=$1 id=$2 want=${3:-}

case $site in
  boj) url="https://www.acmicpc.net/problem/$id" ;;
  pg|sql) url="https://school.programmers.co.kr/learn/courses/30/lessons/$id" ;;
  *) echo "사이트는 boj, pg, sql 중 하나"; exit 1 ;;
esac

existing=$(find stage1 stage2 stage3 -type d -name "$site$id" 2>/dev/null | head -1)

case $want in
  mock/*)
    if [ -d "$want/$site$id" ]; then echo "이미 있음: $want/$site$id"; exit 0; fi
    if [ -n "$existing" ]; then
      echo "주의: 이미 푼 적 있는 문제다 ($existing). 모의 코테에는 처음 보는 문제가 맞다."
    fi
    rows="$want|모의|$site|$id|(시험 뒤에 제목을 적는다)"
    ;;
  *)
    if [ -n "$existing" ]; then
      echo "이미 있음: $existing"
      exit 0
    fi
    rows=$(grep -v '^#' problems.txt | awk -F'|' -v s="$site" -v i="$id" '$3==s && $4==i')
    if [ -n "$want" ]; then
      rows=$(printf '%s\n' "$rows" | awk -F'|' -v p="$want" '$1==p')
    fi
    if [ -z "$rows" ]; then
      echo "problems.txt에 없는 문제: $site $id ${want}"
      echo "교재 밖 문제라면 problems.txt에 한 줄 추가한 뒤 다시 실행한다."
      echo "모의 코테 문제라면: ./new $site $id mock/$(date +%Y-%m-%d)"
      exit 1
    fi
    ;;
esac

IFS='|' read -r path tier _ _ title <<< "$(printf '%s\n' "$rows" | head -1)"
others=$(printf '%s\n' "$rows" | tail -n +2 | cut -d'|' -f1 | tr '\n' ' ')

dir="$path/$site$id"
mkdir -p "$dir"

case $site in
  boj)
    cp templates/boj-Main.java "$dir/Main.java"
    : > "$dir/input1.txt"
    : > "$dir/output1.txt"
    ;;
  pg)
    cp templates/pg-Solution.java "$dir/Solution.java"
    cp templates/pg-Test.java "$dir/Test.java"
    ;;
  sql)
    cp templates/sql-query.sql "$dir/query.sql"
    ;;
esac

cat > "$dir/README.md" <<EOF
# $title

- 링크: $url
- 교재: $path · $tier${others:+ (다른 단계에도 나옴: $others)}
- 상태: 미풀이
- 풀이 시간: (예: 25분, 힌트 받은 시점 18분)
- 제한: (시간 제한, 입력 범위를 문제에서 옮겨 적는다. 예: 1초, N ≤ 100,000)

## 풀이 메모

- 처음 접근:
- 핵심 아이디어:
- 시간·공간복잡도:
- 막힌 곳:
EOF

echo "만듦: $dir"
case $site in
  boj) echo "예제 입력·출력을 $dir/input1.txt, output1.txt에 붙여 넣는다 (여러 개면 input2.txt …)." ;;
  pg)  echo "문제의 solution 틀을 Solution.java에, 입출력 예를 Test.java에 적는다." ;;
  sql) echo "SQL은 프로그래머스에서 실행한다. 통과한 쿼리를 query.sql에 남긴다." ;;
esac
